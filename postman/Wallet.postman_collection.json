        {
          "name": "7. Bob refunds original transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "postman-wallet-demo"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
