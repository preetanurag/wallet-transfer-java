    {
      "name": "02 Transfer and reversal workflow",
      "item": [
        {
          "name": "1. Transfer 100 paise Alice to Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "postman-wallet-demo"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/transfers",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{alice_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{alice_wallet_id}}\",\n  \"to\": \"{{bob_wallet_id}}\",\n  \"amount_paise\": 100,\n  \"idempotency_key\": \"{{transfer_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"transfer_key\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"reversal_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Transfer succeeded\", () => pm.expect(t.status).to.eql(\"succeeded\"));",
                  "if (pm.response.code === 200 && t.status === \"succeeded\") {",
                  " pm.environment.set(\"transfer_id\", t.id);",
                  " pm.environment.set(\"original_transfer_response\", JSON.stringify(t));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Replay same transfer once",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "postman-wallet-demo"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/transfers",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{alice_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{alice_wallet_id}}\",\n  \"to\": \"{{bob_wallet_id}}\",\n  \"amount_paise\": 100,\n  \"idempotency_key\": \"{{transfer_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Identical stored transfer\", () => pm.expect(pm.response.json()).to.eql(JSON.parse(pm.environment.get(\"original_transfer_response\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Changed amount under same key conflicts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "postman-wallet-demo"
              },
              {
