            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": \"{{alice_wallet_id}}\",\n  \"to\": \"{{bob_wallet_id}}\",\n  \"amount_paise\": 101,\n  \"idempotency_key\": \"{{transfer_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
