          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"Refund succeeded\", () => pm.expect(t.status).to.eql(\"succeeded\"));",
                  "pm.test(\"Original transfer linked\", () => pm.expect(t.reversal_of).to.eql(pm.environment.get(\"transfer_id\")));",
                  "if (pm.response.code === 200 && t.status === \"succeeded\") {",
                  " pm.environment.set(\"reversal_id\", t.id);",
                  " pm.environment.set(\"original_reversal_response\", JSON.stringify(t));",
                  "}"
                ]
              }
            }
          ]
        },
