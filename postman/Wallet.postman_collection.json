{
  "info": {
    "name": "Wallet Transfer Java \u2014 Local API",
    "_postman_id": "22a48d80-8419-4af7-b0ee-6ea4f4de03d4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders in order against seeded, isolated demo wallets. Requires Alice >= 100 paise. Successful full run transfers 100 paise then refunds it. Does not fund/reset balances. Tokens are environment variables. Do not run on real-money wallets."
  },
  "item": [
    {
      "name": "01 Wallet setup",
      "item": [
        {
          "name": "Get or create alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "postman-wallet-demo"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/wallets",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{alice_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set(\"alice_wallet_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get or create bob",
